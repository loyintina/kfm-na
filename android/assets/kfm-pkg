#!/data/data/dev.kfm.na/files/usr/bin/bash
# kfm-pkg — L2 overlay 运行时安装器(na 终端内用;设计 docs/active/l2-overlay.md)
#
#   kfm-pkg install <名>   从交接点装 overlay(拉包→解包→建链→跑 postinst→登记)
#   kfm-pkg list           已装包清单(有中断残留会一并吼出)
#
# 交接(设计页 §3,2026-08-22 实拍修正):na 读共享存储根被拒(scoped
# storage 不吃 targetSdk 28 的 legacy 牌)——改走手机本机回环 HTTP:
# Termux 侧 scripts/serve-overlays.sh 起静态服务(127.0.0.1:8027),
# 这里 curl 拉包;KFM_OVERLAY_URL 可改;本地文件路径留作逃生门。
#
# 原子性(BAR-031,2026-08-24;zsh 卡死案病根):安装非原子,中途被杀
# 留残局(.so 在、符号链接没建 → 运行时链接失败)。对策三件套:
#   ①中断标记:铺文件前挂 var/kfm-pkg/<名>.partial,装成才摘——任何
#     kfm-pkg 调用看到残留标记都会吼出自愈命令;
#   ②重装自愈:全流程幂等重放(文件 .kfm-new+mv / ln -snf / postinst),
#     重跑 install 必愈,不需要单独的「修复」子命令;
#   ③装后校验:payload 文件齐 + 符号链接全通才摘标记,缺一件即非零
#     退出——静默残局从此不可能。
set -euo pipefail

PREFIX=${KFM_PREFIX:-/data/data/dev.kfm.na/files/usr}
OVERLAY_URL=${KFM_OVERLAY_URL:-http://127.0.0.1:8027}
OVERLAY_DIR=${KFM_OVERLAY_DIR:-/storage/emulated/0/工作台/kfm-na-overlays}
DB="$PREFIX/var/kfm-pkg"

# 中断残留巡检:任何调用先吼(自愈命令一并给出)
warn_partials() {
    local p n
    for p in "$DB"/*.partial; do
        [ -f "$p" ] || continue
        n=$(basename "$p" .partial)
        echo "[kfm-pkg] ⚠ $n 上次安装中断——重跑 kfm-pkg install $n 自愈" >&2
    done
}

cmd=${1:-}
case "$cmd" in
install)
    name=${2:-}
    [ -n "$name" ] || { echo "用法: kfm-pkg install <名>"; exit 1; }
    mkdir -p "$DB"
    warn_partials
    [ -f "$DB/$name.partial" ] && echo "[kfm-pkg] $name 上次装到一半,本次重装即自愈"
    staging="$PREFIX/tmp/kfm-pkg-$name"
    rm -rf "$staging"; mkdir -p "$staging"
    # 本地文件逃生门:FUSE 上 -f/-r 都可能是「看得见读不了」的假象
    # (2026-08-22 实拍:stat 过、open 拒)——直接试拷,拷不动才走 HTTP
    local_file="$OVERLAY_DIR/na-overlay-$name.tar.gz"
    if ! cp "$local_file" "$staging/overlay.tar.gz" 2>/dev/null; then
        curl -fsSL "$OVERLAY_URL/na-overlay-$name.tar.gz" -o "$staging/overlay.tar.gz" \
            || { echo "[kfm-pkg] 拉不到 $OVERLAY_URL/na-overlay-$name.tar.gz(Termux 侧 kalo/8027 在跑吗?)"; exit 1; }
    fi
    tar -xzf "$staging/overlay.tar.gz" -C "$staging"
    [ -d "$staging/payload" ] || { echo "[kfm-pkg] 包里没有 payload/——不是合法 overlay"; exit 1; }

    # ①中断标记:从这一刻起到校验通过,被杀都留痕(BAR-031)
    echo "$name" > "$DB/$name.partial"

    # 活体覆盖防护(2026-08-22 实拍):运行中的 shell 映射着 $PREFIX/lib
    # 里的 .so,cp 原地截断覆写会把活体崩掉(装完 base 会话 exit -1)——
    # 逐文件 .kfm-new + mv 原子替换,旧 inode 陪老进程到寿终
    (cd "$staging/payload" && find . -depth -type d -exec mkdir -p "$PREFIX/{}" \;)
    (cd "$staging/payload" && find . -type f | while read -r f; do
        cp "$f" "$PREFIX/$f.kfm-new" && mv -f "$PREFIX/$f.kfm-new" "$PREFIX/$f"
    done)

    # 测试缝(考题专用,生产勿设):模拟「文件铺完、链接未建」的被杀现场
    [ "${KFM_PKG_FAKE_KILL:-}" = "after-files" ] && { echo "[kfm-pkg] 测试缝:模拟中断(after-files)"; exit 42; }

    # 符号链接(target←link,U+2190;对齐 bootstrap 建链语义)
    if [ -s "$staging/SYMLINKS.txt" ]; then
        while IFS= read -r line; do
            [ -n "$line" ] || continue
            target=${line%%←*}
            link=${line#*←}
            mkdir -p "$PREFIX/$(dirname "$link")"
            ln -snf "$target" "$PREFIX/$link"
        done < "$staging/SYMLINKS.txt"
    fi

    # maintainer 脚本(打包侧已改写 na 路径;非零不致命,逐包登记设计页 §6)
    for s in "$staging"/maint/*.postinst; do
        [ -f "$s" ] || continue
        echo "[kfm-pkg] postinst: $(basename "$s")"
        PREFIX="$PREFIX" PATH="$PREFIX/bin" LD_LIBRARY_PATH="$PREFIX/lib" \
            bash "$s" || echo "[kfm-pkg] 警告: $(basename "$s") 非零退出(继续)"
    done

    # ③装后校验:文件齐 + 链接通,缺一即失败(标记不摘,重装自愈)
    bad=0
    while read -r f; do
        [ -f "$PREFIX/$f" ] || { echo "[kfm-pkg] 校验缺文件: $f" >&2; bad=1; }
    done < <(cd "$staging/payload" && find . -type f)
    if [ -s "$staging/SYMLINKS.txt" ]; then
        while IFS= read -r line; do
            [ -n "$line" ] || continue
            link=${line#*←}
            [ -e "$PREFIX/$link" ] || { echo "[kfm-pkg] 校验断链: $link" >&2; bad=1; }
        done < "$staging/SYMLINKS.txt"
    fi
    if [ "$bad" -ne 0 ]; then
        echo "[kfm-pkg] ❌ $name 装后校验未过(中断标记保留)——重跑 kfm-pkg install $name 自愈" >&2
        exit 1
    fi

    # 登记(按包去重,重装不攒重复行)+ 摘标记
    touch "$DB/installed"
    grep '^packages=' "$staging/MANIFEST" | cut -d= -f2- | tr ' ' '\n' | while read -r pkg; do
        [ -n "$pkg" ] || continue
        grep -qxF "$pkg" "$DB/installed" || echo "$pkg" >> "$DB/installed"
    done
    rm -f "$DB/$name.partial"
    rm -rf "$staging"
    echo "[kfm-pkg] $name 安装完成"
    ;;
list)
    mkdir -p "$DB"
    warn_partials
    cat "$DB/installed" 2>/dev/null || echo "(空)"
    ;;
*)
    echo "用法: kfm-pkg install <名> | list"
    exit 1
    ;;
esac
