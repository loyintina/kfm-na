<!-- MAIN0175 A 案（2026-10-17，白露楼3 拍板：窄门方向对、放行须附实证）：
     targetSdk28 起明文 http 默认禁（SPKE-web 尖刺坑单③预言，state.md
     2026-09-12 条），WebView 卡开 demo 页（http://127.0.0.1:9021/ui/demo/）
     须放行回环明文。
     窄门：只放 127.0.0.1 与 localhost 两个回环域（includeSubdomains=false），
     不含任何域名白名单——浏览器卡远期开任意 http 站的全域放开归其正式
     立项再议，此处不开。外域 http 仍被拦（承影判卷对照臂）。 -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
