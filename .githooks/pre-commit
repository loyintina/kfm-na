#!/bin/sh
# KFM-NA — pre-commit hook（2026-09-23 全天服务器闸版，Termux 自主化第一步）：
#   全天 → 服务器本地跑全量 chain。依据：2026-09-01 修订实测白天合规
#   （双甲下全量 52s、PSI 峰值 0.00）；2026-09-23 用户拍板——日常闸不再
#   依赖 Termux 资产（chain-phone 降级为可选工具，见 AGENTS.md 跨线
#   运维公约 1；stamp 机制随之退役，改了代码当场跑当场验）。
#   纯 docs 提交无代码可验，照旧豁免。
cd "$(dirname "$0")/.." || exit 1
# 2026-09-30 评审加：宣告"本链来自提交钩"——信箱步骤据此跳过**派生投影检查**
# （投影是全册属性，别人没 gen 会挡住你的提交；内容执法照跑）。理由见
# scripts/check/mailbox.sh 那段注释。
export KFM_CHAIN_FROM_HOOK=1
NOW_HASH=$(git diff --cached HEAD -- . ':(exclude)docs' | md5sum | cut -d' ' -f1)
if [ "$NOW_HASH" = "d41d8cd98f00b204e9800998ecf8427e" ]; then
    echo "✅ 纯 docs 提交，无代码可验（chain 闸不适用）"
    exit 0
fi

# ---- 早失败段（BAR-278，MAIN0192 楼1287-1302）：领号脚本形制一致性 ----
# 为什么在这而不是 chain 的某一步：它防的是**提交**（悬铃 1294①），不是业务步骤；
# 且单文件判据是秒级，没理由排在 cargo 之后（空谷 1293）。放这里等于不占链步号，
# 13 步编号与 docs 里「第 N 步」的引用都不用动。
# 读**暂存版**（空谷 1296／悬铃 1300）：闸要判「将被提交的那份」，不是工作区
# 那个可能还没 git add 的版本。
# 段名自报（悬铃 1297）：红了必须能看出是哪一段拦的，否则等于「无缘无故失败」。
echo "[pre-commit] 早失败段①：领号脚本形制（读暂存版）…"
if ! git show :scripts/bar-new.sh 2>/dev/null | grep -q 'tools: bar-new.sh'; then
    echo "❌ [早失败段①／领号脚本形制] 暂存版 scripts/bar-new.sh 未带工具署名 trailer——" >&2
    echo "   形制：提交信息末行独立写 tools: bar-new.sh（BAR-278；MAIN0192 楼1207／1215）。" >&2
    echo "   为何在此拦：工具不自署 ⇒「谁写的」无法核，号库提交门会把下一次领号拒在半路。" >&2
    exit 1
fi
echo "✅ [早失败段①／领号脚本形制] 暂存版含 tools: bar-new.sh"
HOUR=$(date +%H)
if [ "$HOUR" -ge 1 ] && [ "$HOUR" -lt 7 ]; then
    bash scripts/chain.sh || exit 1
    exit 0
fi
echo "[pre-commit] 白天全量 chain（双甲，全天服务器闸 2026-09-23 起）…"
ionice -c3 nice -n 19 bash scripts/chain.sh || exit 1
